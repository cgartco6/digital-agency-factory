# ---- LLM Routing (NO local GPU; everything is cloud) ----
LLM_PROVIDER=openai            # openai | anthropic | replicate
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# ---- Orchestrator ----
ORCHESTRATOR_DB=./.factory/state.db
ORCHESTRATOR_WORKSPACE=./generated_workspace
ORCHESTRATOR_CONCURRENCY=8
ORCHESTRATOR_MAX_HEAL_ATTEMPTS=3
COVERAGE_GATE=95.0

# ---- Command Center ----
COMMAND_CENTER_REFRESH=3
